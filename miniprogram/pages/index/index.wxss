page { background: #f2f6f5; color: #203c3b; }
.page { box-sizing: border-box; min-height: 100vh; padding: 48rpx 32rpx 80rpx; }
.intro { padding: 12rpx 4rpx 34rpx; }
.eyebrow { color: #4c817c; font-size: 20rpx; font-weight: 700; letter-spacing: 4rpx; }
.heading { margin-top: 12rpx; font-size: 52rpx; font-weight: 700; letter-spacing: 3rpx; }
.intro-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.my-posts { margin: 12rpx 0 0; padding: 0 24rpx; background: #e1efeb; color: #317b70; font-size: 24rpx; line-height: 60rpx; border-radius: 12rpx; }
.my-posts::after { border: 0; }
.intro-note { margin-top: 10rpx; color: #6b8581; font-size: 26rpx; }
.composer { background: #fff; border: 1rpx solid #dcebe7; border-radius: 20rpx; padding: 26rpx; box-shadow: 0 8rpx 28rpx rgba(31, 77, 68, .05); }
.composer-title { font-size: 28rpx; font-weight: 600; }
.editor { box-sizing: border-box; width: 100%; height: 160rpx; margin-top: 20rpx; font-size: 28rpx; line-height: 1.6; }
.category-row { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 4rpx 0 16rpx; }
.category { margin: 0; padding: 0 18rpx; border-radius: 10rpx; background: #f0f5f3; color: #557b72; font-size: 23rpx; line-height: 52rpx; }
.category::after { border: 0; }
.category.selected { background: #dceee8; color: #236e62; font-weight: 600; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-row { display: inline-flex; flex-wrap: nowrap; }
.comment { margin: 0; padding: 0 22rpx; border-radius: 10rpx; background: #f0f5f3; color: #4d7971; font-size: 24rpx; line-height: 56rpx; }
.comment::after { border: 0; }
.composer-footer { display: flex; align-items: center; justify-content: space-between; padding-top: 18rpx; border-top: 1rpx solid #eaf1ef; }
.count { color: #839b96; font-size: 23rpx; }
.publish { margin: 0; padding: 0 38rpx; border-radius: 12rpx; background: #317b70; color: #fff; font-size: 26rpx; line-height: 68rpx; }
.publish::after, .retry::after { border: 0; }
.publish[disabled] { background: #a8c5bf; color: #fff; }
.section-header { display: flex; align-items: baseline; justify-content: space-between; margin: 46rpx 4rpx 22rpx; }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-hint { color: #78918d; font-size: 23rpx; }
.post { margin-bottom: 18rpx; padding: 26rpx; border-radius: 16rpx; background: #fff; }
.post-top { display: flex; align-items: center; }
.post-mark { width: 14rpx; height: 14rpx; border-radius: 50%; background: #71b69f; }
.post-label { margin-left: 12rpx; color: #4d7971; font-size: 23rpx; font-weight: 600; }
.post-time { margin-left: auto; color: #90a5a1; font-size: 22rpx; }
.post-content { margin-top: 18rpx; color: #27413e; font-size: 29rpx; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }
.post-actions { display: flex; justify-content: flex-end; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.like { margin: 0; padding: 0 22rpx; border-radius: 10rpx; background: #f0f5f3; color: #4d7971; font-size: 24rpx; line-height: 56rpx; }
.like::after { border: 0; }
.like.liked { background: #e1efeb; color: #236e62; font-weight: 600; }
.like[disabled] { color: #a4b5b1; background: #f2f4f3; }
.state { padding: 54rpx 20rpx; color: #829893; font-size: 26rpx; text-align: center; }
.inline-error { padding: 18rpx; color: #a96b42; font-size: 24rpx; text-align: center; }
.retry { display: inline-block; margin-top: 20rpx; padding: 0 28rpx; background: #dcece7; color: #317b70; font-size: 24rpx; line-height: 60rpx; }
.list-end { padding: 20rpx; color: #9aaea9; text-align: center; font-size: 23rpx; }
