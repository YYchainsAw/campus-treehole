<view class="page">
  <view class="intro">
    <text class="eyebrow">CAMPUS TREEHOLE</text>
    <view class="intro-heading">
      <view class="heading">校园树洞</view>
      <button class="my-posts" bindtap="openMyPosts">我的树洞</button>
    </view>
    <view class="intro-note">写下此刻，也看看大家在想什么。</view>
  </view>
  <view class="composer">
    <view class="composer-title">写一条树洞</view>
    <textarea class="editor" placeholder="分享一点今天的想法……" value="{{content}}" maxlength="1000" disabled="{{submitting}}" bindinput="onContentInput" />
    <view class="category-row">
      <button wx:for="{{categories}}" wx:key="value" class="category {{category === item.value ? 'selected' : ''}}" data-category="{{item.value}}" bindtap="chooseCategory" disabled="{{submitting}}">{{item.label}}</button>
    </view>
    <view class="composer-footer">
      <text class="count">{{content.length}} / 1000</text>
      <button class="publish" bindtap="publish" loading="{{submitting}}" disabled="{{submitting}}">发布</button>
    </view>
  </view>
  <view class="section-header">
    <view class="section-title">树洞广场</view>
    <text class="section-hint">最近发布</text>
  </view>
  <scroll-view class="filter-scroll" scroll-x>
    <view class="category-row filter-row">
      <button wx:for="{{filterCategories}}" wx:key="value" class="category {{filterCategory === item.value ? 'selected' : ''}}" data-category="{{item.value}}" bindtap="filterPosts">{{item.label}}</button>
    </view>
  </scroll-view>
  <view wx:if="{{loading && !posts.length}}" class="state">正在加载树洞…</view>
  <view wx:elif="{{loadError && !posts.length}}" class="state">
    <view wx:if="{{loginExpired}}">登录已失效，请到“我的树洞”重新登录或退出。</view>
    <view wx:else>暂时无法加载树洞</view>
    <button class="retry" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{!posts.length}}" class="state">这个分类还没有树洞，写下一条吧。</view>
  <view wx:if="{{loadError && posts.length}}" class="inline-error" bindtap="retry">刷新失败，点击重试</view>
  <view wx:for="{{posts}}" wx:key="id" class="post">
    <view class="post-top">
      <view class="post-mark"></view>
      <text class="post-label">{{item.categoryLabel}}</text>
      <text class="post-time">{{item.displayTime}}</text>
    </view>
    <view class="post-content">{{item.content}}</view>
    <view class="post-actions">
      <button class="comment" data-id="{{item.id}}" bindtap="openComments">评论</button>
      <button class="like {{item.likedByMe ? 'liked' : ''}}" data-id="{{item.id}}" bindtap="toggleLike" disabled="{{pendingLikes[item.id]}}" aria-label="{{item.likedByMe ? '取消点赞' : '点赞'}}，{{item.likeCount}} 个赞">{{item.likedByMe ? '已赞' : '赞'}} · {{item.likeCount}}</button>
    </view>
  </view>
  <view wx:if="{{loadingMore}}" class="list-end">正在加载…</view>
  <view wx:elif="{{posts.length && !hasMore}}" class="list-end">已显示全部树洞</view>
</view>
