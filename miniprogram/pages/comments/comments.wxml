<view class="page">
  <view class="heading">评论</view>
  <view class="intro-note">说说你的想法</view>
  <view class="composer">
    <textarea class="editor" placeholder="写下评论……" value="{{content}}" maxlength="500" disabled="{{submitting}}" bindinput="onContentInput" />
    <view class="composer-footer">
      <text class="count">{{content.length}} / 500</text>
      <button class="publish" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">发表评论</button>
    </view>
  </view>
  <view wx:if="{{loading && !comments.length}}" class="state">正在加载评论…</view>
  <view wx:elif="{{loadError && !comments.length}}" class="state">
    <view>暂时无法加载评论，请检查树洞是否存在或登录是否失效。</view>
    <button class="retry" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{!comments.length}}" class="state">还没有评论，来发表第一条吧。</view>
  <view wx:if="{{loadError && comments.length}}" class="inline-error" bindtap="retry">刷新失败，点击重试</view>
  <view wx:for="{{comments}}" wx:key="id" class="post">
    <view class="post-top"><text class="post-label">评论</text><text class="post-time">{{item.displayTime}}</text></view>
    <view class="post-content">{{item.content}}</view>
  </view>
  <view wx:if="{{loadingMore}}" class="list-end">正在加载…</view>
  <view wx:elif="{{comments.length && !hasMore}}" class="list-end">已显示全部评论</view>
</view>
